{
  "name": "ai-whatsapp-employee",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev:web": "npm --prefix apps/web run dev",
    "dev:api": "php apps/api/artisan serve",
    "horizon": "php apps/api/artisan horizon",
    "migrate": "php apps/api/artisan migrate",
    "seed": "php apps/api/artisan db:seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  }
}
